<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ labels.document_title }}</title>
<style>
  @page { size: A4; margin: 10mm; }
  body { font-family: Consolas, "Courier New", monospace; font-size: 8.5pt; color: #000; margin: 0; }
  .top { display: flex; justify-content: space-between; border-bottom: 1px dashed #000; padding-bottom: 5px; }
  .top h1 { font-size: 11pt; text-transform: uppercase; margin: 0; }
  .grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 6px 8px; margin: 7px 0; }
  .block { border: 1px solid #000; padding: 4px 5px; }
  .block b { display: block; text-transform: uppercase; }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; text-transform: uppercase; border-top: 1px solid #000; border-bottom: 1px solid #000; padding: 2px 3px; }
  td { padding: 2px 3px; }
  .number { text-align: right; white-space: nowrap; }
  .foot { border-top: 1px dashed #000; margin-top: 4px; padding-top: 4px; display: flex; justify-content: space-between; }
  .sum { font-weight: bold; text-transform: uppercase; }
</style>
</head>
<body>
{% macro party(label, p) %}
  <div class="block">
    <b>{{ label }}</b>
    {{ p.name }}<br>
    {{ p.address }}<br>
    {{ p.country | country_name }}
  </div>
{% endmacro %}
<div class="top">
  <h1>{{ labels.document_title }}</h1>
  <div>{{ labels.invoice_number | upper }} {{ invoice.invoice_number }} | {{ labels.invoice_date | upper }} {{ invoice.invoice_date.strftime(date_format) | upper }}</div>
</div>
<div class="grid">
  {{ party(labels.shipper, invoice.shipper) }}
  {{ party(labels.buyer, invoice.buyer) }}
  {{ party(labels.consignee, invoice.consignee) }}
  {% if invoice.notify_party %}{{ party(labels.notify_party, invoice.notify_party) }}{% endif %}
  <div class="block">
    <b>SHIPMENT</b>
    {{ labels.incoterm | upper }}: {{ invoice.incoterm }}<br>
    {{ labels.currency | upper }}: {{ invoice.currency }}<br>
    {{ labels.net_weight | upper }} {{ invoice.net_weight_kg }} KGS<br>
    {{ labels.gross_weight | upper }} {{ invoice.gross_weight_kg }} KGS
  </div>
</div>
<table>
  <thead>
    <tr>
      <th>SR</th>
      <th>{{ labels.description }}</th>
      {% if show_hs %}<th>{{ labels.hs_code }}</th>{% endif %}
      <th class="number">{{ labels.quantity }}</th>
      <th>{{ labels.unit }}</th>
      <th class="number">{{ labels.unit_price }}</th>
      <th class="number">{{ labels.amount }}</th>
    </tr>
  </thead>
  <tbody>
    {% for line in invoice.line_items %}
    <tr>
      <td>{{ "%02d" | format(loop.index) }}</td>
      <td>{{ line.description }}</td>
      {% if show_hs %}<td>{{ line.hs_code_on_doc }}</td>{% endif %}
      <td class="number">{{ line.quantity }}</td>
      <td>{{ line.unit }}</td>
      <td class="number">{{ line.unit_price }}</td>
      <td class="number">{{ line.amount }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<div class="foot">
  <span>ITEMS: {{ invoice.line_items | length }}</span>
  <span class="sum">{{ labels.total }} {{ invoice.currency }} {{ invoice.total_amount }}</span>
</div>
</body>
</html>
