<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Commercial Invoice</title>
<style>
  @page { size: A4; margin: 14mm 15mm; }
  body { font-family: "Times New Roman", Times, serif; font-size: 10.5pt; color: #111; margin: 0; }
  .letterhead { text-align: center; border-bottom: 3px double #111; padding-bottom: 8px; }
  .letterhead h1 { font-size: 15pt; margin: 0 0 3px; }
  .letterhead p { margin: 0; font-size: 9pt; }
  h2 { text-align: center; font-size: 13pt; letter-spacing: 3px; margin: 12px 0; }
  table { width: 100%; border-collapse: collapse; }
  .meta td, .parties td { border: 1px solid #111; padding: 5px 7px; vertical-align: top; }
  .parties { margin-top: 8px; }
  .parties td { width: 50%; }
  .label { font-weight: bold; }
  .items { margin-top: 10px; }
  .items th { border: 1px solid #111; background: #e9e9e9; padding: 4px 5px; font-size: 9pt; }
  .items td { border: 1px solid #111; padding: 3px 5px; font-size: 9pt; }
  .number { text-align: right; white-space: nowrap; }
  .total td { font-weight: bold; font-size: 10pt; }
  .weights { margin-top: 10px; }
  .declaration { margin-top: 14px; font-size: 9pt; }
  .signature { margin-top: 26px; text-align: right; }
</style>
</head>
<body>
{% set show_hs = invoice.line_items | selectattr("hs_code_on_doc") | list | length > 0 %}
<div class="letterhead">
  <h1>{{ invoice.shipper.name }}</h1>
  <p>{{ invoice.shipper.address }}, {{ invoice.shipper.country | country_name }}</p>
</div>
<h2>COMMERCIAL INVOICE</h2>
<table class="meta">
  <tr>
    <td><span class="label">Invoice No:</span> {{ invoice.invoice_number }}</td>
    <td><span class="label">Date:</span> {{ invoice.invoice_date.strftime(date_format) }}</td>
  </tr>
  <tr>
    <td><span class="label">Terms of Delivery:</span> {{ invoice.incoterm }}</td>
    <td><span class="label">Currency:</span> {{ invoice.currency }}</td>
  </tr>
</table>
<table class="parties">
  <tr>
    <td>
      <div class="label">Shipper / Exporter</div>
      {{ invoice.shipper.name }}<br>
      {{ invoice.shipper.address }}<br>
      {{ invoice.shipper.country | country_name }}
    </td>
    <td>
      <div class="label">Consignee</div>
      {{ invoice.consignee.name }}<br>
      {{ invoice.consignee.address }}<br>
      {{ invoice.consignee.country | country_name }}
    </td>
  </tr>
</table>
<table class="items">
  <thead>
    <tr>
      <th>No.</th>
      <th>Description of Goods</th>
      {% if show_hs %}<th>HS Code</th>{% endif %}
      <th>Quantity</th>
      <th>Unit</th>
      <th>Unit Price</th>
      <th>Amount</th>
    </tr>
  </thead>
  <tbody>
    {% for line in invoice.line_items %}
    <tr>
      <td>{{ loop.index }}</td>
      <td>{{ line.description }}</td>
      {% if show_hs %}<td>{{ line.hs_code_on_doc }}</td>{% endif %}
      <td class="number">{{ line.quantity | quantity }}</td>
      <td>{{ line.unit }}</td>
      <td class="number">{{ line.unit_price | money }}</td>
      <td class="number">{{ line.amount | money }}</td>
    </tr>
    {% endfor %}
    <tr class="total">
      <td colspan="{{ 6 if show_hs else 5 }}" class="number">Total {{ invoice.currency }}</td>
      <td class="number">{{ invoice.total_amount | money }}</td>
    </tr>
  </tbody>
</table>
<p class="weights">
  <span class="label">Net Weight:</span> {{ invoice.net_weight_kg | money }} KG &nbsp;&nbsp;
  <span class="label">Gross Weight:</span> {{ invoice.gross_weight_kg | money }} KG
</p>
<p class="declaration">We certify that this invoice is true and correct and that the goods described are as shipped.</p>
<p class="signature">Authorised Signature ____________________</p>
</body>
</html>
