<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ labels.document_title }}</title>
<style>
  @page {
    size: A4;
    margin: 16mm 15mm 20mm;
    @bottom-center { content: counter(page) " / " counter(pages); font-family: Verdana, sans-serif; font-size: 7.5pt; }
  }
  body { font-family: Verdana, Geneva, sans-serif; font-size: 8.5pt; color: #1a1a1a; margin: 0; }
  .meta { text-align: right; line-height: 1.7; margin-bottom: 16px; }
  .meta h1 { font-size: 13pt; font-weight: bold; margin: 0 0 6px; }
  .party { margin-bottom: 11px; line-height: 1.5; }
  .party b { display: block; }
  .terms { margin: 14px 0 18px; }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-weight: bold; padding: 6px 5px 12px; }
  td { padding: 21px 5px; vertical-align: top; }
  tr { break-inside: avoid; }
  .number { text-align: right; white-space: nowrap; }
  .closing { break-inside: avoid; margin-top: 18px; text-align: right; line-height: 1.8; }
  .closing .total { font-weight: bold; font-size: 11pt; }
</style>
</head>
<body>
{% macro party(label, p) %}
  <div class="party">
    <b>{{ label }}</b>
    {{ p.name }}, {{ p.address }}, {{ p.country | country_name }}
  </div>
{% endmacro %}
<div class="meta">
  <h1>{{ labels.document_title }}</h1>
  <div>{{ labels.invoice_number }} {{ invoice.invoice_number }}</div>
  <div>{{ labels.invoice_date }} {{ invoice.invoice_date.strftime(date_format) }}</div>
</div>
{{ party(labels.shipper, invoice.shipper) }}
{{ party(labels.buyer, invoice.buyer) }}
{{ party(labels.consignee, invoice.consignee) }}
{% if invoice.notify_party %}{{ party(labels.notify_party, invoice.notify_party) }}{% endif %}
<div class="terms">{{ labels.incoterm }}: {{ invoice.incoterm }} &nbsp;&middot;&nbsp; {{ labels.currency }}: {{ invoice.currency }}</div>
<table>
  <thead>
    <tr>
      <th>{{ labels.description }}</th>
      {% if show_hs %}<th>{{ labels.hs_code }}</th>{% endif %}
      <th>{{ labels.unit }}</th>
      <th class="number">{{ labels.unit_price }}</th>
      <th class="number">{{ labels.quantity }}</th>
      <th class="number">{{ labels.amount }}</th>
    </tr>
  </thead>
  <tbody>
    {% for line in invoice.line_items %}
    <tr>
      <td>{{ line.description }}</td>
      {% if show_hs %}<td>{{ line.hs_code_on_doc }}</td>{% endif %}
      <td>{{ line.unit }}</td>
      <td class="number">{{ line.unit_price | money }}</td>
      <td class="number">{{ line.quantity | quantity }}</td>
      <td class="number">{{ line.amount | money }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<div class="closing">
  <div>{{ labels.net_weight }} {{ invoice.net_weight_kg | money }} kg</div>
  <div>{{ labels.gross_weight }} {{ invoice.gross_weight_kg | money }} kg</div>
  <div class="total">{{ labels.total }} {{ invoice.currency }} {{ invoice.total_amount | money }}</div>
</div>
</body>
</html>
