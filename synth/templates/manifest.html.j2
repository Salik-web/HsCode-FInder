<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ labels.document_title }}</title>
<style>
  /* Held-out layout (2026-11-17): like ledger, each party is one printed line, but with a
     different separator, typeface, orientation and structure. Not for prompt tuning. */
  @page { size: A4 landscape; margin: 11mm 13mm 12mm; }
  body { font-family: "Bundled DejaVu Sans Condensed", "Bundled DejaVu Sans", sans-serif; font-size: 8pt; color: #222; margin: 0; }
  .band { display: flex; justify-content: space-between; align-items: center;
          background: #3b4651; color: #fff; padding: 7px 10px; }
  .band h1 { font-size: 12pt; letter-spacing: 1px; margin: 0; text-transform: uppercase; }
  .band .ref { text-align: right; line-height: 1.5; }
  table { width: 100%; border-collapse: collapse; }
  .parties { margin-top: 8px; }
  .parties th { width: 34mm; text-align: left; background: #e6e9ec; font-weight: bold; }
  .parties th, .parties td { border: 0.6pt solid #9aa3ab; padding: 4px 6px; }
  .terms { margin: 7px 0; padding: 4px 6px; border-left: 3pt solid #3b4651; background: #f3f4f5; }
  .goods th { background: #3b4651; color: #fff; text-align: left; padding: 4px 6px; }
  .goods th.number { text-align: right; }
  .goods td { padding: 3px 6px; border-bottom: 0.5pt solid #c9ced3; }
  .goods tr:nth-child(even) td { background: #f6f7f8; }
  .number { text-align: right; white-space: nowrap; }
  .foot { display: flex; justify-content: space-between; margin-top: 8px; }
  .weights { line-height: 1.6; }
  .total { border: 1pt solid #3b4651; padding: 5px 10px; font-size: 10pt; font-weight: bold; }
</style>
</head>
<body>
{% macro party(label, p, reference=none) %}
  <tr>
    <th>{{ label }}</th>
    <td>{% if reference %}{{ reference }}{% else %}{{ p.name }} | {{ p.address }} | {{ p.country | country_name }}{% endif %}</td>
  </tr>
{% endmacro %}
<div class="band">
  <h1>{{ labels.document_title }}</h1>
  <div class="ref">
    <div>{{ labels.invoice_number }}: {{ invoice.invoice_number }}</div>
    <div>{{ labels.invoice_date }}: {{ invoice.invoice_date.strftime(date_format) }}</div>
  </div>
</div>
<table class="parties">
  {{ party(labels.shipper, invoice.shipper) }}
  {{ party(labels.buyer, invoice.buyer, buyer_reference) }}
  {{ party(labels.consignee, invoice.consignee) }}
  {% if invoice.notify_party %}{{ party(labels.notify_party, invoice.notify_party) }}{% endif %}
</table>
<div class="terms">{{ labels.incoterm }} {{ invoice.incoterm }} &nbsp;/&nbsp; {{ labels.currency }} {{ invoice.currency }}</div>
<table class="goods">
  <thead>
    <tr>
      {% if show_hs %}<th>{{ labels.hs_code }}</th>{% endif %}
      <th>{{ labels.description }}</th>
      <th class="number">{{ labels.quantity }}</th>
      <th>{{ labels.unit }}</th>
      <th class="number">{{ labels.unit_price }}</th>
      <th class="number">{{ labels.amount }}</th>
    </tr>
  </thead>
  <tbody>
    {% for line in invoice.line_items %}
    <tr>
      {% if show_hs %}<td>{{ line.hs_code_on_doc }}</td>{% endif %}
      <td>{{ line.description }}</td>
      <td class="number">{{ line.quantity | quantity }}</td>
      <td>{{ line.unit }}</td>
      <td class="number">{{ line.unit_price | money }}</td>
      <td class="number">{{ line.amount | money }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
<div class="foot">
  <div class="weights">
    <div>{{ labels.net_weight }}: {{ invoice.net_weight_kg | money }} kg</div>
    <div>{{ labels.gross_weight }}: {{ invoice.gross_weight_kg | money }} kg</div>
  </div>
  <div class="total">{{ labels.total }} {{ invoice.currency }} {{ invoice.total_amount | money }}</div>
</div>
</body>
</html>
