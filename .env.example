# Copy to .env. Never commit .env.

# Root folder for generated data
DATA_DIR=data

# Postgres + pgvector (docker-compose.yml)
POSTGRES_USER=tradedoc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tradedoc
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
# Hosted Postgres (Neon, Supabase), e.g. postgresql+psycopg://user:pass@host/db?sslmode=require
# When set, it overrides the POSTGRES_* values above.
DATABASE_URL=

# LLM providers (OpenAI-compatible). Keys stay in .env, never in git.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
# Primary model; switching provider or model is configuration only.
LLM_PROVIDER=groq
LLM_MODEL=qwen/qwen3.8-27b
# Sent as `reasoning_effort`; "none" turns Qwen thinking off. Leave empty for the provider default.
LLM_REASONING_EFFORT=none
# Ask the provider to enforce the JSON schema. Off: on Groq it often returns a truncated
# object, and our own validation and retry enforce the schema either way.
LLM_STRICT_SCHEMA=false
# json_object: ask only for a JSON object; prompt v3 lists the keys. json_schema: send the schema.
LLM_RESPONSE_FORMAT=json_object
# Client-side throttle under the provider's per-minute limits (empty: no limit).
LLM_TOKENS_PER_MINUTE=8000
LLM_OUTPUT_TOKENS_PER_MINUTE=1000
LLM_REQUESTS_PER_MINUTE=30
# Used only with `evals.run --fallback` (and by the API later) when the primary is rate-limited.
FALLBACK_PROVIDER=groq
FALLBACK_MODEL=qwen/qwen3.8-27b
FALLBACK_REASONING_EFFORT=none
FALLBACK_STRICT_SCHEMA=false
FALLBACK_RESPONSE_FORMAT=json_object
FALLBACK_TOKENS_PER_MINUTE=8000
FALLBACK_OUTPUT_TOKENS_PER_MINUTE=1000
FALLBACK_REQUESTS_PER_MINUTE=30
# USD per million tokens; 0 on free tiers. Set real prices to see real cost per document.
LLM_INPUT_USD_PER_MILLION_TOKENS=0
LLM_OUTPUT_USD_PER_MILLION_TOKENS=0
LLM_CONCURRENCY=2
# Per-call output cap. Groq's 1,000 output tokens a minute is also its per-call ceiling;
# thinking models such as Gemini need 16000.
LLM_MAX_OUTPUT_TOKENS=1000
FALLBACK_MAX_OUTPUT_TOKENS=1000

# HS reranking: text only, never a vision call. Groq counts gpt-oss-120b's quota apart from qwen's.
HS_PROVIDER=groq
HS_MODEL=openai/gpt-oss-120b
HS_REASONING_EFFORT=low
HS_STRICT_SCHEMA=false
HS_RESPONSE_FORMAT=json_object
HS_TOKENS_PER_MINUTE=8000
HS_OUTPUT_TOKENS_PER_MINUTE=
HS_REQUESTS_PER_MINUTE=30
HS_INPUT_USD_PER_MILLION_TOKENS=0
HS_OUTPUT_USD_PER_MILLION_TOKENS=0
HS_MAX_OUTPUT_TOKENS=2000
# Local sentence-transformers model for tariff retrieval (384 dimensions, as tariff_codes).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Public demo (the Docker image sets DEMO_MODE=true). Groq limits are per organization, so
# these caps protect the project's daily quota. Defaults in app/config.py.
DEMO_MODE=false
DEMO_SESSION_UPLOADS=2
DEMO_VISITOR_DAILY_UPLOADS=3
DEMO_DAILY_UPLOADS=10
DEMO_HS_LINES=5
DEMO_RETENTION_MINUTES=60
# Salt for hashing visitor IPs (set a random value as a Space secret).
DEMO_UPLOADER_SALT=

# Langfuse tracing (optional: without keys, calls aren't traced)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
